{
  "name": "the-jacket-maker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "start": "node server/server.js",
    "start:server": "npm --prefix server start",
    "seed": "npm --prefix server run seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0"
  }
}
